diff --git a/subsys/usb/device_next/class/Kconfig.msc b/subsys/usb/device_next/class/Kconfig.msc
index 98069d906..c1da9233d 100644
--- a/subsys/usb/device_next/class/Kconfig.msc
+++ b/subsys/usb/device_next/class/Kconfig.msc
@@ -30,6 +30,18 @@ config USBD_MSC_SCSI_BUFFER_SIZE
 	  Buffer size must be able to hold at least one sector. All LUNs within
 	  single instance share the SCSI buffer.
 
+config USBD_MSC_MEDIUM_LOCK
+	bool "Allow the host to lock the medium"
+	default y
+	help
+	  Honor PREVENT ALLOW MEDIUM REMOVAL requests to lock the medium.
+	  When disabled, lock requests are rejected, as on most card
+	  readers. Hosts such as macOS then keep polling TEST UNIT READY
+	  while the volume is mounted, so a disk that starts reporting
+	  "medium not present" (disk_access_status() returning
+	  DISK_STATUS_NOMEDIA) is unmounted cleanly instead of being
+	  surprise-removed when the device disconnects.
+
 config USBD_MSC_DOUBLE_BUFFERING
 	bool "SCSI double buffering"
 	default y
diff --git a/subsys/usb/device_next/class/usbd_msc_scsi.c b/subsys/usb/device_next/class/usbd_msc_scsi.c
index ad88b08af..a02532da2 100644
--- a/subsys/usb/device_next/class/usbd_msc_scsi.c
+++ b/subsys/usb/device_next/class/usbd_msc_scsi.c
@@ -642,6 +642,13 @@ SCSI_CMD_HANDLER(PREVENT_ALLOW_MEDIUM_REMOVAL)
 		ctx->prevent_removal = false;
 		break;
 	case MEDIUM_REMOVAL_SHALL_BE_PREVENTED:
+		if (!IS_ENABLED(CONFIG_USBD_MSC_MEDIUM_LOCK)) {
+			/* Like a card reader: the medium cannot be locked. Hosts
+			 * then keep polling TEST UNIT READY, so a device that
+			 * reports MEDIUM NOT PRESENT gets unmounted cleanly.
+			 */
+			return illegal_request(ctx, INVALID_FIELD_IN_CDB);
+		}
 		ctx->prevent_removal = true;
 		break;
 	case PREVENT_OBSOLETE_2:
