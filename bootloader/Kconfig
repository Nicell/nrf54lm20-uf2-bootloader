mainmenu "UF2 Bootloader"

source "Kconfig.zephyr"

menu "UF2 Bootloader options"

config UF2_USBD_VID
    hex "USB Vendor ID"
    default 0x1915
    help
      Default 0x1915 is Nordic Semiconductor's VID, which Nordic permits
      for development on their parts. The PID below is a placeholder; both
      should be replaced with an assigned VID/PID before shipping. Most
      hosts only key off VID/PID for driver matching.

config UF2_USBD_PID
    hex "USB Product ID"
    default 0x3e85

config UF2_USBD_MANUFACTURER
    string "USB manufacturer string"
    default "ZMK"

config UF2_USBD_PRODUCT
    string "USB product string"
    default "ZMK UF2 Bootloader"

config UF2_DOUBLE_TAP
    bool "Enter DFU on a double reset"
    default y
    help
      On every normal boot, arm the boot-mode flag and wait
      UF2_DOUBLE_TAP_DELAY_MS before starting the app; a second reset
      inside that window enters DFU. Costs that delay on every boot, so
      turn it off on boards without a reset button.

config UF2_DOUBLE_TAP_DELAY_MS
    int "Double-tap detection window (ms)"
    depends on UF2_DOUBLE_TAP
    default 500
    range 100 5000

config UF2_REBOOT_DELAY_MS
    int "Delay between committing an image and rebooting into it (ms)"
    default 250
    help
      Lets the host finish its trailing SCSI traffic (FAT/directory
      updates) before the device disappears.

config UF2_BOARD_ID
    string "Board ID string for INFO_UF2.TXT"
    default "ZMK-nRF54LM20-v0"

config UF2_PRODUCT_NAME
    string "Product name for INFO_UF2.TXT"
    default "ZMK nRF54LM20 Bootloader"

config UF2_VOLUME_LABEL
    string "FAT volume label (11 chars, padded)"
    default "54LM20BOOT "

config UF2_INDEX_URL
    string "URL placed in INDEX.HTM"
    default "https://zmk.dev/"

config UF2_FAMILY_ID
    hex "UF2 family ID for this board"
    default 0x4ED75C3F
    help
      Unique 32-bit family ID for this board. Used by the host-side UF2
      tooling to refuse images built for a different chip family. Should
      eventually be registered at https://github.com/microsoft/uf2.

config UF2_NUM_BLOCKS
    int "Number of 512-byte sectors in the synthesized FAT16 volume"
    default 65801
    help
      Must result in a FAT16 cluster count >= 0x1015 and < 0xFFD5. The
      default (0x10109) yields a 32 MiB virtual disk, matching tinyuf2.

endmenu
